                  "startLine": 27
                }
              }
            }
          ]
        },
        {
          "ruleId": "python-subprocess-shell-true-format",
          "level": "error",
          "message": {
            "text": "Subprocess call with `shell=True` and a dynamically constructed command string (f-string or format). This is vulnerable to shell injection. Use a list of arguments without `shell=True`, or use `shlex.quote()` to sanitize inputs."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/mnt/lambda/github/github.com/codeanttesting/codeant-demo/ed6a2f3e27ef742f7972b0072a3195543e3f93aa/security_vulns.py"
                },
                "region": {
                  "startLine": 34
                }
              }
            }
          ]
        },
        {
          "ruleId": "python-weak-hash-md5",
          "level": "error",
          "message": {
            "text": "Use of MD5 hash algorithm detected. MD5 is cryptographically broken and should not be used for security purposes such as password hashing or integrity verification. Use a stronger algorithm like SHA-256 or bcrypt."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/mnt/lambda/github/github.com/codeanttesting/codeant-demo/ed6a2f3e27ef742f7972b0072a3195543e3f93aa/security_vulns.py"
                },
                "region": {
                  "startLine": 40
                }
              }
            }
          ]
        },
        {
          "ruleId": "path-traversal-open",
          "level": "error",
          "message": {
            "text": "Found request data in a call to 'open'. Ensure the request data is validated or sanitized, otherwise it could result in path traversal attacks."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "/mnt/lambda/github/github.com/codeanttesting/codeant-demo/ed6a2f3e27ef742f7972b0072a3195543e3f93aa/security_vulns.py"
